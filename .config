branch=dev
checked=false
clean=true
compress=tar
environment=development
include=.git,.gitignore,.github,LICENSE,README.md,requirements.txt,resources,src
library=
packages=git,openssh-client,python3.11,python3.11-dev,python3.11-venv,tar,unzip,wget,zip
program=kekkijutsu
repository=https://github.com/hxAri/Kekkijutsu
root=false
servers=
version=1.0.0
virtual=/home/virtual/bin/activate
virtualize=true
